# Copy this file to .env.local and fill in values from Supabase Connect.
# These two values are publishable browser configuration, not service-role keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Change these deliberately when a deployed parser revision changes.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_PARSER_VERSION=1
